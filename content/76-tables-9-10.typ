// Reference Chapter, § 2. Tables: Tables 9 and 10. Printed pages 312-321.
// Table 9 fills three spreads (312-317): the left page of each carries the
// columns g(C), g, k, dim k, dim p, rk g, the right page the Satake
// diagrams and the columns Type of Σ, r, dim g_λ, dim g_2λ of the same
// rows, in the same order. Table 10 begins on page 318 with its
// description; its body is printed sideways on pages 319-320 and upright
// on page 321. Page 322 begins the Bibliography.
#import "main-defs.typ": *
#import "statements.typ": *
#import "diagrams/dynkin.typ": bond, dynkin, gap, pair, v
#import "diagrams/76-tables-9-10.typ": e6-arched

// Satake diagrams of Table 9. The widest (eight grid steps) and the four
// columns beside it share the width of the page only with a grid a little
// smaller than the default of dynkin.typ.
#let table-9-grid = 7mm
#let satake = dynkin.with(unit: table-9-grid)

// The cyclic group ⟨Z⟩_m of order m generated by Z (Table 10).
#let cyclic(generator, order) = $chevron.l generator chevron.r_order$

// Table 9 is printed on three spreads, and its blocks follow them: the left
// page of a spread, the real forms and their Cartan decompositions, then the
// right page, the same rows continued.
#let table-9-left(
  columns: (auto, auto, auto, 1fr, auto, auto),
  ..rows,
) = book-table(
  columns: columns,
  align: center + horizon,
  head: (
    [$frak(g)(CC)$],
    [$frak(g)$],
    [$frak(k)$],
    [$dim frak(k)$],
    [$dim frak(p)$],
    [$rk_RR frak(g)$],
  ),
  ..rows,
)
#let table-9-right(
  columns: (auto, auto, 1.15fr, 1fr, auto),
  ..rows,
) = book-table(
  columns: columns,
  align: center + horizon,
  head: (
    [Satake diagram],
    [Type \ of $Sigma$],
    [$r$],
    [$dim frak(g)_(lambda_j)$],
    [$dim frak(g)_(2 lambda_j)$],
  ),
  ..rows,
)

// A sideways part of Table 10 (pages 319-320), one page as printed. Its
// columns but one are as wide as their widest entry, which a wider inset
// than the tables' keeps clear of the rules.
#let table-10(..rows) = sideways(book-table(
  columns: (auto, auto, 1fr, auto, auto, auto),
  inset: (x: 0.7em, y: 0.5em),
  align: (
    center + horizon,
    center + horizon,
    left + horizon,
    center + horizon,
    center + horizon,
    center + horizon,
  ),
  head: (
    [$frak(g)$],
    [$Z(G)$],
    table.cell(align: center + horizon)[Generators of $Z(G)$],
    [$Lambda(G)$],
    [$G_"lin"$],
    [$b_0$],
  ),
  ..rows,
))

#table-section[Real Simple Lie Algebras] <tab:real-simple-lie-algebras>
#source(327)In the table are listed noncompact real Lie algebras $frak(g)$ that
do not admit a complex structure, i.e. the real forms of complex simple Lie
algebras $frak(g)(CC)$. The column "Type of $Sigma$" contains the type of the
system $Sigma$ of real roots. The column "$r$" describes the restriction map
$r: Pi_1 -> Theta$, where $Theta$ is the base of $Sigma$. The simple roots from
$Pi$ are denoted by $alpha_j$, those from $Theta$ by $lambda_j$; the numbering
in both these systems is the same as in Table~@tab:weights-and-roots.

